      "name": "OAuth",
      "description": {
        "content": "Endpoint for OAuth 2.0 functionality.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ec80741c-1e03-41ae-9dbf-060bfc62e2f7",
          "name": "Get OAuth Token",
          "request": {
            "name": "Get OAuth Token",
            "description": {
              "content": "Authenticate your client to receive an OAuth Bearer token. This endpoint uses Basic Authentication with your client ID as the username and the client secret as the password.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "The grant type to use for authentication."
                }
              ]
            }
          },
          "response": [
            {
              "id": "9de74d29-5c72-4dc9-bf04-ff1c815804be",
              "name": "Successful authentication.",
              "originalRequest": {
                "url": {
                  "path": [
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "The grant type to use for authentication.",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "client_credentials"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"xxx.yyy.zzz\",\n  \"token_type\": \"bearer\",\n  \"expires_in\": 899,\n  \"scope\": \"trust read write\",\n  \"jti\": \"3b4cc123-2164-44cb-ae34-9c76d7c429ab\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
